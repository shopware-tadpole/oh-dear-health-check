<?xml version="1.0"?>
<ruleset name="Winkelwagen PSR-12">
    <description>PSR-12, minus what the Shopware Store forces on us.</description>

    <file>src</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <!-- Line length is a PSR-12 warning: show it, but don't fail the pipeline on it. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="PSR12">
        <!-- The Shopware Store requires our producer prefix on the plugin class: wwagen_<name>. -->
        <exclude name="Squiz.Classes.ValidClassName.NotCamelCaps"/>
    </rule>

    <!-- Tests may keep small helper/stub classes next to the test case. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
</ruleset>
